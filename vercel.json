{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx prisma generate",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/graphql", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/auth/:path*", "destination": "/api/index" },
    { "source": "/upload/:path*", "destination": "/api/index" },
    { "source": "/uploads/:path*", "destination": "/api/index" }
  ]
}
