# PostgreSQL, in dev and in production. Point this at a local instance or a
# hosted one (Prisma Postgres, Neon, Supabase).
DATABASE_URL="postgresql://user:password@localhost:5432/tredella"
JWT_SECRET="change-me-in-production"
PORT=4000
# Browser origins allowed to call this API. A `*` matches one label, so
# "https://buyer-tredella-*.vercel.app" covers Vercel preview deployments.
CORS_ORIGINS="http://localhost:3000,https://buyer-tredella.vercel.app,https://www.buyer-tredella.vercel.app,https://buyer-tredella-*.vercel.app"

# Public URL of the buyer site — used to build password-reset links
APP_URL="http://localhost:3000"

# SMTP for password-reset emails. Leave SMTP_USER/SMTP_PASS blank in dev and
# the reset link is printed to the server console instead of being emailed.
# Gmail requires an App Password, not the account password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Tredella <no-reply@tredella.com>"

# Where seller KYC documents (trade licence, Emirates ID) are stored.
# Without this the API falls back to local disk, which a serverless host cannot
# use — set it before deploying. Cloudinary shows this string on its dashboard.
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
