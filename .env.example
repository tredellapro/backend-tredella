# Dev: SQLite (zero setup). Production: switch prisma/schema.prisma provider
# to "postgresql" and use a PostgreSQL connection string.
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"
PORT=4000
# Browser origins allowed to call this API. A `*` matches one label, so
# "https://buyer-tredella-*.vercel.app" covers Vercel preview deployments.
CORS_ORIGINS="http://localhost:3000,https://buyer-tredella.vercel.app,https://www.buyer-tredella.vercel.app,https://buyer-tredella-*.vercel.app"

# Public URL of the buyer site — used to build password-reset links
APP_URL="http://localhost:3000"

# SMTP for password-reset emails. Leave SMTP_USER/SMTP_PASS blank in dev and
# the reset link is printed to the server console instead of being emailed.
# Gmail requires an App Password, not the account password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Tredella <no-reply@tredella.com>"
